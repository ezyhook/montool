{
  "name": "montool",
  "version": "1.0.0",
  "description": "Telegram server monitor bot — Node or Bun + grammy",
  "type": "module",
  "repository": "github:ezyhook/montool",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "esbuild index.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist/index.js",
    "start": "node dist/index.js",
    "prestart": "npm run build",
    "start:tsx": "tsx index.ts",
    "dev": "tsx watch index.ts",
    "start:bun": "bun run index.ts",
    "dev:bun": "bun --watch run index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "grammy": "^1.31.0",
    "classic-level": "^1.4.1",
    "sharp": "^0.33.4"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "tsx": "^4.19.2",
    "@types/node": "^22.0.0",
    "typescript": "^5.5.4"
  }
}
